{
  "manifest_version": 3,
  "name": "AI Spine",
  "description": "Live sycophancy check for claude.ai and chatgpt.com - does this AI actually hold its ground, or does it just fold?",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open AI Spine"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["src/content-script.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ]
}
